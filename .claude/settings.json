{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'r=\"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\"; exec bash \"$r/.claude/hooks/hook-alive-smoke.sh\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'r=\"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\"; exec bash \"$r/.claude/hooks/hook-alive-smoke.sh\"'"
          }
        ]
      }
    ]
  }
}
